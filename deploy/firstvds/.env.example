# Public API hostname. The DNS A record must point to the FirstVDS IP.
API_DOMAIN=api.gridsside.ru

# Published PWA origin used by backend CORS. Do not add a trailing slash.
FRONTEND_ORIGIN=https://grudsside.github.io

# Full public PWA URL used only by production verification.
FRONTEND_PUBLIC_URL=https://grudsside.github.io/bar-manager-ai

# Supabase Session pooler connection string (port 5432), with sslmode=require.
# Paste the value from Supabase Connect -> Session pooler and insert the database password.
DATABASE_URL=postgresql://postgres.oincykbznwhphqlrdcak:DB_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Generated automatically by configure-instance.sh, or manually with: openssl rand -hex 32
OWNER_API_KEY=

# Added in later integration stages.
OPENAI_API_KEY=
OPENAI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OWNER_TELEGRAM_ID=
# Optional fixed delivery target for Telegram webhook requests.
# Useful during a VDS migration while DNS caches may still contain the previous IP.
TELEGRAM_WEBHOOK_IP=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Supabase server-side settings. Never expose the service role key in frontend code.
SUPABASE_URL=https://oincykbznwhphqlrdcak.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=bar-manager-files
