# Public API hostname. DNS A record must point to the FirstVDS IP.
API_DOMAIN=api.example.com

# Published PWA origin. Do not add a trailing slash.
FRONTEND_ORIGIN=https://grudsside.github.io

# Supabase Session pooler connection string (port 5432), with sslmode=require.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Generate with: openssl rand -hex 32
OWNER_API_KEY=

# Added in later integration stages.
OPENAI_API_KEY=
OPENAI_MODEL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
OWNER_TELEGRAM_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Supabase server-side settings. Never expose the service role key in frontend code.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=bar-manager-files
